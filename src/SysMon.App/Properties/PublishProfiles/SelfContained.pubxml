<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone build: one .exe that runs on any Windows 10/11 x64 machine with no
  .NET runtime installed. Larger, but it is what makes this distributable as a utility.

  Note: trimming is deliberately off. WPF is not trim-safe, and a trimmed build breaks
  XAML resource lookup at runtime rather than at build time.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\publish\self-contained\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
