<UserControl x:Class="SysMon.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SysMon.App.Controls">

    <UserControl.Resources>
        <!-- One full-width graph row: label, current value, and the trace itself. -->
        <Style x:Key="GraphCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="0,0,10,0">
        <StackPanel Margin="0,0,4,16">

            <Border Style="{StaticResource GraphCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="CPU UTILISATION" />
                        <TextBlock Style="{StaticResource MetricValue}" HorizontalAlignment="Right" Text="{Binding Cpu.PrimaryValue}" />
                    </Grid>
                    <ctl:HistoryGraph Grid.Row="1" ShowGrid="True" StrokeThickness="1.8"
                                      LineColor="{StaticResource CpuColor}" Series="{Binding Cpu.Series}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GraphCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="CPU TEMPERATURE" />
                        <TextBlock Style="{StaticResource MetricValue}" HorizontalAlignment="Right" Text="{Binding Cpu.Temperature}" />
                    </Grid>
                    <!-- Fixed 0-100 °C axis: a temperature graph that rescales itself makes a
                         cool CPU look alarming. -->
                    <ctl:HistoryGraph Grid.Row="1" ShowGrid="True" StrokeThickness="1.8" Maximum="100"
                                      LineColor="{StaticResource WarnColor}" Series="{Binding CpuTemperatureSeries}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Gpus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GraphCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="88" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Subtitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding PrimaryValue}" />
                                        <TextBlock Style="{StaticResource MetricValue}" Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Temperature}" />
                                    </StackPanel>
                                </Grid>
                                <ctl:HistoryGraph Grid.Row="1" ShowGrid="True" StrokeThickness="1.8"
                                                  LineColor="{StaticResource GpuColor}" Series="{Binding Series}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource GraphCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="MEMORY" />
                        <TextBlock Style="{StaticResource MetricValue}" HorizontalAlignment="Right" Text="{Binding Memory.Subtitle}" />
                    </Grid>
                    <ctl:HistoryGraph Grid.Row="1" ShowGrid="True" StrokeThickness="1.8"
                                      LineColor="{StaticResource MemoryColor}" Series="{Binding Memory.Series}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GraphCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="NETWORK" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource MetricValue}" Foreground="{StaticResource NetworkDownBrush}" Text="{Binding Network.Download}" />
                            <TextBlock Style="{StaticResource MetricValue}" Margin="12,0,0,0"
                                       Foreground="{StaticResource NetworkUpBrush}" Text="{Binding Network.Upload}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ctl:HistoryGraph ShowGrid="True" AutoScale="True" StrokeThickness="1.8"
                                          LineColor="{StaticResource NetworkUpColor}" Series="{Binding Network.UploadSeries}" />
                        <ctl:HistoryGraph AutoScale="True" StrokeThickness="1.8"
                                          LineColor="{StaticResource NetworkDownColor}" Series="{Binding Network.Series}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource GraphCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource CardTitle}" Text="DISK ACTIVITY" />
                    </Grid>
                    <ctl:HistoryGraph Grid.Row="1" ShowGrid="True" StrokeThickness="1.8"
                                      LineColor="{StaticResource DiskColor}" Series="{Binding Storage.Series}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
